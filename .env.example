# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA - debateIA
# ==============================================================================

# ----------------- BASE DE DATOS POSTGRESQL + PGVECTOR -----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret_password_change_me
POSTGRES_DB=debateia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:secret_password_change_me@postgres:5432/debateia

# ----------------- LLM (DEEPSEEK V3) ------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----------------- BÚSQUEDA WEB EN TIEMPO REAL -------------------------------
# Puedes usar Tavily (recomendado para agentes) o Brave Search
TAVILY_API_KEY=tvly-your-tavily-api-key-here
BRAVE_API_KEY=

# ----------------- BIOMETRÍA VOCAL Y STT -------------------------------------
CANDIDATE_PROFILE_PATH=/app/candidate_profile.npy
SPEAKER_SIMILARITY_THRESHOLD=0.70
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VAD_THRESHOLD=0.5
SILENCE_DURATION_MS=400
MAX_UTTERANCE_MS=4500

# ----------------- GOOGLE DRIVE SYNC (RAG INTERNO) ---------------------------
# ID de la carpeta compartida en Drive con los planes de gobierno y dossiers
GOOGLE_DRIVE_FOLDER_ID=1abcXYZ_your_drive_folder_id_here
# Ruta al archivo JSON de credenciales de la Cuenta de Servicio de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/app/service_account.json
# Alternativamente, el contenido del JSON en base64 para Coolify:
GOOGLE_SERVICE_ACCOUNT_B64=

# ----------------- FRONTEND PWA -----------------------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/audio
PORT=3000
